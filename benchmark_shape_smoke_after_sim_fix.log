import numpy as np

shape_info = get_object_shape()
obj_pos, _, _ = get_object_pose("object")
grasp_quat = np.array([0, 0, 1, 0])
grasp_pos = obj_pos.copy()

if shape_info['shape'] == 'cylinder':
    grasp_pos[2] = obj_pos[2] + shape_info['size']['height'] / 2 + 0.01
elif shape_info['shape'] == 'box':
    grasp_pos[2] = obj_pos[2] + shape_info['size']['z'] / 2 + 0.01
else:
    grasp_pos[2] = obj_pos[2] + shape_info['size']['diameter'] / 2 + 0.01

open_gripper()
goto_pose(grasp_pos, grasp_quat, z_approach=0.1)
goto_pose(grasp_pos, grasp_quat)
close_gripper()
lift_pos = grasp_pos.copy()
lift_pos[2] += 0.1
goto_pose(lift_pos, grasp_quat)


