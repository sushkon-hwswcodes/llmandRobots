# Code block 0
import numpy as np

# Step 1: Get hand capabilities
hand_info = get_hand_capabilities()

# Step 2: Get object shape and grasp hint
shape_info = get_object_shape()
object_shape = shape_info["shape"]
grasp_hint = shape_info["grasp_hint"]

# Step 3: Sample a grasp pose for the object
grasp_pos, grasp_quat = sample_grasp_pose("object")

# Step 4: Choose pregrasp and close names based on object shape
if object_shape == "ball":
    pregrasp_name = "pregrasp"
    close_name = "close"
elif object_shape == "cylinder":
    pregrasp_name = "pregrasp"
    close_name = "grasp_soft"
elif object_shape == "box":
    pregrasp_name = "open"
    close_name = "grasp_soft"
else:
    pregrasp_name = "pregrasp"
    close_name = "grasp_soft"

# Step 5: Set hand to preshaped position
set_hand_preshape(pregrasp_name)

# Step 6: Move to grasp pose with z_approach=0.12
goto_pose(grasp_pos, grasp_quat, z_approach=0.12)

# Step 7: Move to grasp pose with z_approach=0.04
goto_pose(grasp_pos, grasp_quat, z_approach=0.04)

# Step 8: Move to grasp pose exactly
goto_pose(grasp_pos, grasp_quat)

# Step 9: Set hand to close position (except for ball)
if object_shape != "ball":
    set_hand_preshape(close_name)

# Step 10: Perform a short test lift of 0.04 m
lift_offset = np.array([0, 0, 0.04])
goto_pose(grasp_pos + lift_offset, grasp_quat)

# Step 11: Return to the grasp pose
goto_pose(grasp_pos, grasp_quat)

# Step 12: Reinforce with a full close position (only for non-ball objects)
if object_shape != "ball":
    set_hand_preshape("close")

# Step 13: Perform the full lift of 0.10 m
lift_offset = np.array([0, 0, 0.10])
goto_pose(grasp_pos + lift_offset, grasp_quat)


