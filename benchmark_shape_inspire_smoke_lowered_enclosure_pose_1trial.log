# Code block 0
import numpy as np

# Step 1: Get hand capabilities
hand_info = get_hand_capabilities()

# Step 2: Get object shape
shape_info = get_object_shape()

# Step 3: Sample grasp pose for the object
grasp_pos, grasp_quat = sample_grasp_pose("object")

# Step 4: Choose pregrasp_name and close_name based on object shape
if shape_info["shape"] == "ball":
    pregrasp_name = "open"
    close_name = "close"
elif shape_info["shape"] in ["cylinder", "box"]:
    pregrasp_name = "open"
    close_name = "grasp_soft"
else:
    pregrasp_name = "open"
    close_name = "grasp_soft"

# Step 5: Set hand to pregrasp pose
set_hand_preshape(pregrasp_name)

# Step 6: Move to grasp position with z_approach=0.12
goto_pose(grasp_pos, grasp_quat, z_approach=0.12)

# Step 7: Move to grasp position with z_approach=0.04
goto_pose(grasp_pos, grasp_quat, z_approach=0.04)

# Step 8: Move to exact grasp position
goto_pose(grasp_pos, grasp_quat)

# Step 9: Set hand to close pose unless the object is a ball
if shape_info["shape"] != "ball":
    set_hand_preshape(close_name)

# Step 10: Lift by 0.04 m
lift_offset = np.array([0, 0, 0.04])
goto_pose(grasp_pos + lift_offset, grasp_quat)

# Step 11: Return once to grasp position
goto_pose(grasp_pos, grasp_quat)

# Step 12: Set hand to full close pose
set_hand_preshape("close")

# Step 13: Lift by 0.10 m
lift_offset = np.array([0, 0, 0.10])
goto_pose(grasp_pos + lift_offset, grasp_quat)


